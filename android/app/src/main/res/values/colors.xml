<?xml version="1.0" encoding="utf-8"?>
<!--
  "Industrial glass" palette, light variant: frosted white panels over a soft
  light base with coloured blobs behind. Dark values (the hero look) in values-night.
-->
<resources>

    <!-- Surfaces -->
    <color name="bg_page">#EEF1F6</color>
    <color name="glass">#B8FFFFFF</color>
    <color name="glass_strong">#D9F7F9FC</color>
    <color name="glass_stroke">#14101828</color>
    <color name="glass_highlight">#CCFFFFFF</color>
    <color name="hairline">#120F172A</color>
    <color name="field">#80FFFFFF</color>
    <color name="bg_hover">#140F172A</color>
    <!-- Cards and list panels: near-opaque surface, crisp border. -->
    <color name="card">#F7FFFFFF</color>
    <color name="card_stroke">#1F0F172A</color>
    <color name="scrim">#330F172A</color>

    <!-- Text -->
    <color name="text">#0F172A</color>
    <color name="text_strong">#020617</color>
    <color name="text_muted">#5B6474</color>
    <color name="text_subtle">#8C95A4</color>

    <!-- Accent (Signal Blue of the portal logo) and severities -->
    <color name="primary">#1238F0</color>
    <color name="primary_soft">#141238F0</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="danger">#D92D20</color>
    <color name="danger_soft">#1FF04438</color>
    <color name="warning">#B54708</color>
    <color name="warning_soft">#24F5A524</color>
    <color name="info">#0E7490</color>
    <color name="info_soft">#1F22B8CF</color>

    <!-- Snackbar: inverse surface -->
    <color name="snackbar">#1E2430</color>
    <color name="on_snackbar">#F5F7FA</color>
    <color name="snackbar_action">#7D98FF</color>

    <!-- The one soft blue light on the page (alpha applied when painted) -->
    <color name="backdrop_glow">#7D98FF</color>

    <!-- Code (command zone, the colors of the review): AA contrast on the code background and on the card -->
    <color name="code_bg">#F3F5F9</color>
    <color name="code_keyword">#6D28D9</color>
    <color name="code_string">#166534</color>
    <color name="code_number">#9A3412</color>
    <color name="code_comment">#596579</color>
    <color name="code_function">#1D4ED8</color>
    <color name="code_type">#0E7490</color>
    <color name="code_operator">#BE123C</color>
    <color name="code_punct">#4B5563</color>
    <color name="code_add">#14632F</color>
    <color name="code_add_bg">#1F137333</color>
    <color name="code_del">#B42318</color>
    <color name="code_del_bg">#1AB91C1C</color>
    <color name="code_hunk">#1D4ED8</color>
    <color name="code_hunk_bg">#121D4ED8</color>
    <color name="code_meta">#4B5563</color>

    <!-- Code of an agent: a muted palette, so it never looks like the command -->
    <color name="agent_keyword">#5D4D8C</color>
    <color name="agent_string">#2F5F3B</color>
    <color name="agent_number">#7E4A2B</color>
    <color name="agent_comment">#596579</color>
    <color name="agent_function">#35508F</color>
    <color name="agent_type">#2C6272</color>
    <color name="agent_operator">#8E3B50</color>
    <color name="agent_punct">#4B5563</color>
    <color name="agent_add">#2A6040</color>
    <color name="agent_add_bg">#0F137333</color>
    <color name="agent_del">#8F3434</color>
    <color name="agent_del_bg">#0DB91C1C</color>
    <color name="agent_hunk">#35508F</color>
    <color name="agent_hunk_bg">#0A1D4ED8</color>
    <color name="agent_meta">#4B5563</color>
</resources>

# Docker Compose converts these host variables into /run/secrets/portal_superadmin_login and
# /run/secrets/portal_superadmin_password. They are not passed as environment variables to the
# application container.
PORTAL_SUPERADMIN_LOGIN=admin
PORTAL_SUPERADMIN_PASSWORD=test1234

PORTAL_IMAGE=local/portal
PORTAL_VERSION=dev
PORTAL_PORT=4181
RUST_VERSION=1.88

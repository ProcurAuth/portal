# Inbox configuration for deploy/k3s (ConfigMap inbox-config).
# Every attribute is mandatory; see docs/configuration.md.

server {
  name            = "Inbox"
  listen          = "0.0.0.0:8080"
  admin_listen    = "0.0.0.0:8081"
  # K3s pod CIDR: Traefik pods pass the client address in X-Forwarded-For.
  trusted_proxies = ["10.42.0.0/16"]
  shutdown_grace  = "10s"
  server_key_file = "/run/secrets/inbox_server_key"
}

storage {
  path                     = "/var/lib/inbox/inbox.db"
  alert_retention          = "30d"
  connection_log_retention = "90d"
}

devices {
  credential_file       = "/run/secrets/inbox_device_credential"
  heartbeat_interval    = "20s"
  session_timeout       = "60s"
  resend_after          = "15s"
  max_inflight          = 32
  unreachable_after     = "2m"
  offline_warning_after = "3m"
  max_devices           = 1000
}

admin {
  # No password: anyone who can reach server.admin_listen can send alerts and
  # revoke devices. The IngressRoute must keep an authenticating middleware.
  # Exact Host header values accepted (DNS-rebinding protection): the ingress
  # host, the in-cluster service name and `kubectl port-forward`.
  allowed_hosts = [
    "inbox-admin.example.org",
    "inbox.apps.svc.cluster.local:8081",
    "localhost:8081",
  ]
}

security {
  max_auth_failures   = 5
  auth_failure_window = "10m"
}

limits {
  max_title_bytes   = 200
  max_message_bytes = 4000
  max_request_bytes = 65536
}

logging {
  level  = "info"
  format = "json"
}

# To export to the cluster collector, allow apps -> observability:4318 in the
# NetworkPolicies first (the default allow-observability policy blocks it):
# telemetry {
#   enabled         = true
#   otlp_endpoint   = "http://otel-collector.observability.svc.cluster.local:4318"
#   service_name    = "inbox"
#   export_interval = "15s"
# }
telemetry {
  enabled = false
}

group "oncall" {
  name        = "Astreinte"
  description = "Pages for the on-call engineer"
}

group "infra" {
  name        = "Infra"
  description = "Infrastructure alerts"
}

# Token generated by init-secrets.sh. Used by scripts, Alertmanager or Grafana.
producer "alerting" {
  token_file            = "/run/secrets/inbox_alerting_token"
  groups                = ["oncall", "infra"]
  webhook_send_resolved = false
}
